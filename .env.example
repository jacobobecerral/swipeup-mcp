# Los activos de cada cliente (propiedades de GSC e IDs de GA4) viven en
# clients.json (privado, ignorado en git). Ver clients.example.json.
#
# NO hay GA4_PROPERTY_ID ni GSC_SITE_URL por defecto: si una herramienta se
# llama sin cliente, site ni property_id devuelve un error, nunca datos.

# Ruta al archivo de credenciales OAuth (relativa a la raíz del proyecto)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Ruta al archivo de token OAuth (se genera automáticamente)
GOOGLE_TOKEN_FILE=token.json

# Ruta al registro privado de clientes (relativa a la raíz del proyecto)
CLIENTS_FILE=clients.json
