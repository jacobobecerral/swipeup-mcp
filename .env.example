# Los activos de cada marca (propiedades de GSC e IDs de GA4) viven en
# clients.json (privado, ignorado en git). Ver clients.example.json.
#
# Estos dos valores son OPCIONALES: se usan solo si una herramienta se llama
# sin 'client', 'site' ni 'property_id'. Puedes dejarlos vacíos.

# ID numérico de propiedad GA4 (NO el ID de medición "G-XXXX")
GA4_PROPERTY_ID=

# Propiedad de Search Console, exactamente como la devuelve gsc_list_properties
# (ej: sc-domain:dominio.com o https://dominio.com/)
GSC_SITE_URL=

# Ruta al archivo de credenciales OAuth (relativa a la raíz del proyecto)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Ruta al archivo de token OAuth (se genera automáticamente)
GOOGLE_TOKEN_FILE=token.json

# Ruta al registro privado de marcas (relativa a la raíz del proyecto)
CLIENTS_FILE=clients.json
