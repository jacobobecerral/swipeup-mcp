# ID de la propiedad de GA4
# Dónde encontrarlo: Google Analytics → Administrar → Propiedad → ID de propiedad
# Formato: solo el número (ej: 123456789)
GA4_PROPERTY_ID=TU_ID_DE_PROPIEDAD_GA4

# URL del sitio en Google Search Console
# Dónde encontrarlo: Search Console → la URL exacta que aparece en el selector de propiedades
# Formato exacto tal como aparece en GSC (ej: https://swipeup.biz/ o sc-domain:swipeup.biz)
GSC_SITE_URL=TU_URL_EN_SEARCH_CONSOLE

# Ruta al archivo de credenciales OAuth (relativa a la raíz del proyecto)
# Normalmente no hay que cambiar esto
GOOGLE_CREDENTIALS_FILE=credentials.json

# Ruta al archivo de token OAuth (se genera automáticamente)
# Normalmente no hay que cambiar esto
GOOGLE_TOKEN_FILE=token.json